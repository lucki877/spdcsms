datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String
  role      String
  createdAt DateTime @default(now())
}

model Charger {
  id          String   @id @default(uuid())
  location    String
  status      String   @default("available")
  installedAt DateTime @default(now())
}
